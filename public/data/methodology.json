{"terminology":{"priority_label":"Threat priority","priority_sublabel":"External prioritisation from public evidence","index_label":"Exploit likelihood"},"statement":"Priority reflects public evidence of exploitation, predicted exploitation likelihood, technical severity and recency. It does not account for whether a product is present or exposed in your environment.","priority_rules":{"p1":{"any":[{"kev":true},{"all":[{"epss_gte":0.5},{"cvss_gte":9.0}]}]},"p2":{"any":[{"epss_percentile_gte":0.99},{"all":[{"epss_gte":0.1},{"cvss_gte":8.0}]},{"all":[{"cvss_gte":9.0},{"published_within_days":30}]}]},"p3":{"any":[{"cvss_gte":7.0},{"epss_percentile_gte":0.9}]},"p4":{"default":true}},"tier_labels":{"P1":"Priority 1 - urgent","P2":"Priority 2 - high attention","P3":"Priority 3 - monitor","P4":"Priority 4 - background"},"thresholds":{"high_epss_probability":0.1,"critical_cvss":9.0,"high_cvss":7.0},"time_windows_days":[7,30,90,365],"default_window_days":30,"sources":{"cisa_kev":{"name":"CISA Known Exploited Vulnerabilities"},"nvd":{"name":"NIST National Vulnerability Database CVE API 2.0"},"epss":{"name":"FIRST Exploit Prediction Scoring System"}}}