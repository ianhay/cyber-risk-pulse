{
  "name": "cyber-risk-pulse",
  "version": "0.1.0",
  "description": "Open-source vulnerability exploitation and prioritisation monitor (CISA KEV + NVD + EPSS)",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:fixture": "python3 scripts/build_fixture_site.py",
    "data:live": "python3 scripts/refresh_data.py",
    "data:validate": "python3 scripts/validate_site.py"
  },
  "dependencies": {
    "@fontsource/inter": "^5.0.0",
    "@fontsource/jetbrains-mono": "^5.0.0",
    "@fontsource/space-grotesk": "^5.0.0",
    "echarts": "^5.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "jsdom": "^25.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
